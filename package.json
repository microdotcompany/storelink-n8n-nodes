{
	"name": "n8n-nodes-storelink",
	"version": "0.1.0",
	"description": "Storelink orders, customers, products and coupons in n8n",
	"license": "MIT",
	"homepage": "https://store.link",
	"keywords": [
		"n8n-community-node-package",
		"storelink",
		"ecommerce"
	],
	"author": {
		"name": "Storelink",
		"email": "care@store.link"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/microdotcompany/n8n-nodes-storelink.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/StorelinkApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Storelink/Storelink.node.js",
			"dist/nodes/StorelinkTrigger/StorelinkTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
